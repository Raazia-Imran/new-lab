{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    { "source": "/index.php", "destination": "/", "permanent": true },
    {
      "source": "/achievements.php",
      "destination": "/achievements/",
      "permanent": true
    },
    { "source": "/clients.php", "destination": "/clients/", "permanent": true },
    {
      "source": "/projects.php",
      "destination": "/projects/",
      "permanent": true
    },
    { "source": "/papers.php", "destination": "/papers/", "permanent": true },
    {
      "source": "/resources.php",
      "destination": "/resources/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://cdn.sanity.io data:; connect-src 'self' https://*.apicdn.sanity.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
